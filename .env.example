# LLM configuration used by example TOML files
# `base_url_env` -> URL for the LLM API (e.g. https://api.example.com/)
LLM_BASE_URL="https://api.example.com/"
# `api_key_env` -> API key for the LLM service
LLM_API_KEY="your-llm-api-key"
# `model_env` -> default model name used in example configs
LLM_MODEL="MODEL_NAME"